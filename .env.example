# ============================================================
#  Plantilla de variables de entorno
#  1) Copia este archivo y renómbralo a ".env"
#  2) Llena los valores (ver README.md, sección "Configurar Firebase")
#  El archivo .env NUNCA se sube a GitHub.
# ============================================================

# ---- Servidor ----
PORT=3000
# Zona horaria usada para la hora (HH:mm) de los mensajes
TIMEZONE=America/Guayaquil

# ---- Seguridad: dominios permitidos (separados por coma, sin "/" al final) ----
# En local: http://localhost:3000
# En Render agrega tu URL, ej: https://mi-chat.onrender.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- JWT propio del servidor ----
# Pon una cadena larga y aleatoria. Puedes generarla con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Duración del JWT de sesión (formato de jsonwebtoken: 60s, 15m, 2h...)
JWT_EXPIRES_IN=15m

# ---- Firebase: configuración de la APP WEB (es pública, va al navegador) ----
# Firebase console > Configuración del proyecto > General > Tus apps > Configuración del SDK
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_APP_ID=

# ---- Firebase Admin: CUENTA DE SERVICIO (es SECRETA, solo para el servidor) ----
# Firebase console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
# Copia del JSON descargado los campos "client_email" y "private_key".
# La private_key va entre comillas dobles y con los \n tal cual vienen en el JSON.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPEGA_AQUI_TU_CLAVE\n-----END PRIVATE KEY-----\n"
