rules_version = '2';

// Reglas de seguridad de Firestore.
// Nadie puede leer ni escribir directamente desde el navegador:
// solo el servidor (index.js) accede con Firebase Admin, que ignora estas reglas.
// Así nadie puede falsificar mensajes ni leer el chat sin pasar por el JWT.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
